+bool InputDevice::handleNativeTouchEvent(QEvent* event)
+{
+    // This board's touch panel (a WaveShare USB HID multitouch device) is
+    // reported by Qt's evdevtouch handler purely as QTouchEvents --
+    // handleTouchEvent() above only ever fires for QMouseEvents, which
+    // depend on Qt's touch-to-mouse synthesis fallback
+    // (AA_SynthesizeMouseForUnhandledTouchEvents) actually triggering. That
+    // fallback has several layered preconditions (event acceptance state,
+    // which window/widget ends up receiving the touch, etc.) that proved
+    // unreliable enough on this EGLFS backend that touch was observed
+    // completely non-responsive. Handling QTouchEvent directly here instead
+    // is far more robust: eventFilter() (being an application-level filter)
+    // sees the raw touch event before any of that synthesis logic runs, so
+    // this path does not depend on it at all.
+    if(!configuration_->getTouchscreenEnabled())
+    {
+        return true;
+    }
+
+    QTouchEvent* touch = static_cast<QTouchEvent*>(event);
+    if(touch->touchPoints().isEmpty())
+    {
+        return true;
+    }
+
+    aasdk::proto::enums::TouchAction::Enum type;
+    switch(event->type())
+    {
+    case QEvent::TouchBegin:
+        type = aasdk::proto::enums::TouchAction::PRESS;
+        break;
+    case QEvent::TouchEnd:
+        type = aasdk::proto::enums::TouchAction::RELEASE;
+        break;
+    default:
+        type = aasdk::proto::enums::TouchAction::DRAG;
+        break;
+    };
+
+    const QTouchEvent::TouchPoint& touchPoint = touch->touchPoints().first();
+    const uint32_t x = (static_cast<float>(touchPoint.pos().x()) / touchscreenGeometry_.width()) * displayGeometry_.width();
+    const uint32_t y = (static_cast<float>(touchPoint.pos().y()) / touchscreenGeometry_.height()) * displayGeometry_.height();
+    OPENAUTO_LOG(info) << "[InputDevice] dispatching NATIVE touch x=" << x << " y=" << y
+                        << " rawPos=(" << touchPoint.pos().x() << "," << touchPoint.pos().y() << ")";
+    eventHandler_->onTouchEvent({type, x, y, 0});
+
+    // Accept the event so Qt's touch-to-mouse synthesis (see
+    // AA_SynthesizeMouseForUnhandledTouchEvents in qguiapplication.cpp)
+    // does not also fire a synthesized QMouseEvent for the same physical
+    // touch, which handleTouchEvent() above would otherwise also process,
+    // double-sending every touch.
+    event->accept();
+    return true;
+}
