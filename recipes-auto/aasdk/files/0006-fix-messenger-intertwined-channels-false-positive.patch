     FrameHeader frameHeader(buffer);
+    const ChannelId channelId = frameHeader.getChannelId();
 
-    if(message_ == nullptr)
+    auto pendingIter = pendingMessages_.find(channelId);
+    if(pendingIter == pendingMessages_.end())
     {
-        message_ = std::make_shared<Message>(frameHeader.getChannelId(), frameHeader.getEncryptionType(), frameHeader.getMessageType());
-    }
